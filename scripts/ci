#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

python_command() {
  if command -v python3 >/dev/null 2>&1; then
    printf '%s\n' python3
  else
    printf '%s\n' python
  fi
}

check_repository() {
  if git rev-parse --verify HEAD^ >/dev/null 2>&1; then
    git diff --check HEAD^ HEAD
  fi
  git diff --check
  bash -n scripts/ci

  if [[ -f go.mod ]]; then
    local unformatted
    unformatted=$(gofmt -l $(git ls-files '*.go'))
    if [[ -n "$unformatted" ]]; then
      printf 'Go files need gofmt:\n%s\n' "$unformatted" >&2
      return 1
    fi
    go vet ./...
  fi

  if [[ -f pyproject.toml ]]; then
    command -v uv >/dev/null
    [[ -f uv.lock ]]
    uv sync --locked
    uv run ruff check .
  fi
}

test_repository() {
  local python_bin
  python_bin=$(python_command)
  "$python_bin" -m unittest discover -s tests/ci -p 'test_*.py' -v

  if [[ -f go.mod ]]; then
    go test ./...
  fi

  if [[ -f pyproject.toml ]]; then
    command -v uv >/dev/null
    [[ -f uv.lock ]]
    uv sync --locked
    uv run pytest
  fi
}

case "${1:-all}" in
  check)
    check_repository
    ;;
  test)
    test_repository
    ;;
  all)
    check_repository
    test_repository
    ;;
  *)
    printf 'usage: %s [check|test|all]\n' "$0" >&2
    exit 2
    ;;
esac
